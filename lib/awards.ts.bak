import fs from "fs";
import path from "path";

export type AwardStatus = "won" | "nominated" | null;

export interface OtherAwards {
    oscar?: AwardStatus;
    globe?: AwardStatus;
    sag?: AwardStatus;
    dga?: AwardStatus;
    bafta?: AwardStatus;
    pga?: AwardStatus;
    wga?: AwardStatus;
    ace?: AwardStatus;
    adg?: AwardStatus;
    asc?: AwardStatus;
    cdg?: AwardStatus;
    muah?: AwardStatus;
    scl?: AwardStatus;
    ves?: AwardStatus;
}

export interface NomineeContributor {
    name: string;
    role?: string;
}

export interface Nominee {
    name: string;
    film: string;
    character?: string;
    songTitle?: string;
    adaptedSource?: string;
    role?: string;
    otherOtherAwards?: OtherAwards;
    isWinner?: boolean;
    contributors?: NomineeContributor[];
}

export function formatNamesList(names: string[]): string {
    if (!names || names.length === 0) return "";

    // Alphabetize names by last word
    const sortedNames = [...names].sort((a, b) => {
        const aWords = a.trim().split(/\s+/);
        const bWords = b.trim().split(/\s+/);
        const aLast = aWords[aWords.length - 1].toLowerCase();
        const bLast = bWords[bWords.length - 1].toLowerCase();
        return aLast.localeCompare(bLast);
    });

    if (sortedNames.length === 1) return sortedNames[0];
    if (sortedNames.length === 2) return `${sortedNames[0]} and ${sortedNames[1]}`;
    return `${sortedNames.slice(0, -1).join(', ')}, and ${sortedNames[sortedNames.length - 1]}`;
}

// YearData for Category page (timeline of best actors, etc.)
export interface YearData {
    year: number;
    winner: Nominee | null;
    nominees: Nominee[];
}

// Category structure for Year pages
export interface Category {
    name: string;
    icon: string;
    group: string;
    winner: (Nominee & { isWinner: true }) | null;
    nominees: Nominee[];
}

